# OpenAI 兼容模型接口
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=70000

# 是否在生成后额外调用一次模型做合理性复核
AI_REVIEW_ENABLED=true

# 服务监听
HOST=0.0.0.0
PORT=3001

# standalone 用于独立演示；integrated 用于官网接入
JIAHUI_DEPLOYMENT_MODE=standalone

# 官网服务端调用 /api/v1 时使用，至少 32 个随机字符
INTERNAL_SERVICE_TOKEN=

# 异步任务的短期持久化目录、并发数和保留时间
JOB_DATA_DIR=.runtime/jobs
JOB_CONCURRENCY=2
JOB_RETENTION_HOURS=24
JOB_QUEUE_LIMIT=100
JOB_USER_ACTIVE_LIMIT=10

# 官网 R2 签名下载链接允许使用的域名，多个域名用逗号分隔
R2_ALLOWED_HOSTS=
